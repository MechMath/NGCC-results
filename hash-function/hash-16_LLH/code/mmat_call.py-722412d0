#!/usr/bin/env python3
"""Call the role-gated MMAT tool surface directly when stdio transport is down.

This uses the same ToolServer, domain plugin, operation registry and permission
checks as the MCP session; only the outer JSON-RPC transport is replaced.
"""

from __future__ import annotations

import json
import pathlib
import sys

from mmat.agent.mcp_server import ToolServer
from mmat.graph.store import Store


DB = pathlib.Path(
    "/home/mmat/mmat-preview/campaigns/rebuild-20261119/"
    "runs/rebuild-100-hash-16-ds02/graph.db"
)


def main() -> int:
    if len(sys.argv) < 2:
        raise SystemExit("usage: mmat_call.py TOOL [JSON_OBJECT]")
    name = sys.argv[1]
    if len(sys.argv) > 2 and sys.argv[2].startswith("contract@"):
        args = {
            "action": "set",
            "contract": json.loads(pathlib.Path(sys.argv[2][9:]).read_text()),
            "expected_version": 0,
        }
    elif len(sys.argv) > 2 and sys.argv[2].startswith("start@"):
        args = {
            "action": "start",
            **json.loads(pathlib.Path(sys.argv[2][6:]).read_text()),
        }
    elif len(sys.argv) > 2 and sys.argv[2].startswith("@"):
        args = json.loads(pathlib.Path(sys.argv[2][1:]).read_text())
    else:
        args = json.loads(sys.argv[2]) if len(sys.argv) > 2 else {}
    store = Store(str(DB))
    try:
        server = ToolServer(
            store, store.root(), "", "orch", 1, role="orch", workspace="."
        )
        result = server.call(name, args)
        print(json.dumps(result, ensure_ascii=False, indent=2, default=str))
        return 0 if result.get("status") != "error" else 1
    finally:
        store.close()


if __name__ == "__main__":
    raise SystemExit(main())
