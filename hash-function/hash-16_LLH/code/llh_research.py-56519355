DERANGEMENT = [
    4, 9, 18, 23, 8, 1, 22, 15, 12, 17, 6, 3,
    20, 5, 10, 19, 0, 21, 14, 11, 16, 13, 2, 7,
]

D_MATRIX = [
    [0, 1, 1, 1],
    [1, 0, 1, 1],
    [1, 1, 0, 1],
    [1, 1, 1, 0],
]


def rotr6(x: int, n: int) -> int:
    return ((x >> n) | (x << (6 - n))) & 0x3F


def s6(x: int) -> int:
    return x ^ rotr6(x, 2) ^ (rotr6(x, 1) & rotr6(x, 3)) ^ 0x1B


def s24(x: int) -> int:
    v = [(x >> i) & 1 for i in range(24)]
    y = [0] * 24
    for col in range(4):
        word = sum(v[col + 4 * row] << row for row in range(6))
        out = s6(word)
        for row in range(6):
            y[col + 4 * row] = (out >> row) & 1
    z = [y[DERANGEMENT[i]] for i in range(24)]
    out = []
    for row in range(6):
        r = z[4 * row:4 * row + 4]
        out.extend(sum(r[i] * D_MATRIX[i][j] for i in range(4)) & 1
                   for j in range(4))
    return sum(bit << i for i, bit in enumerate(out))


def rol_word(x: int, n: int, w: int) -> int:
    mask = (1 << w) - 1
    n %= w
    return ((x << n) | (x >> (w - n))) & mask


def sub_column(state: list[int], w: int) -> list[int]:
    out = [0] * 24
    for j in range(w):
        x = sum(((state[i] >> j) & 1) << i for i in range(24))
        y = s24(x)
        for i in range(24):
            out[i] |= ((y >> i) & 1) << j
    return out


def shift_rows(state: list[int], w: int) -> list[int]:
    return [rol_word(state[i], SHIFTS[w][i], w) for i in range(24)]


def round_fun(state: list[int], w: int, round_index: int) -> list[int]:
    out = shift_rows(sub_column(state, w), w)
    out[23] ^= ROUND_CONSTANTS[w][round_index]
    return out


def permutation(state: list[int], w: int, rounds: int) -> list[int]:
    out = state.copy()
    for t in range(rounds):
        out = round_fun(out, w, t)
    return out


def pad_bits(message: list[int], rate: int) -> list[int]:
    if not message or len(message) % rate == 0:
        return message.copy()
    return message + [1] * (-len(message) % rate)


def absorb_block(state: list[int], block: list[int], w: int, rounds: int) -> list[int]:
    rate_words = 8
    mask = (1 << w) - 1
    permuted = permutation(state, w, rounds)
    out = permuted.copy()
    for i in range(rate_words):
        word = sum(block[i * w + j] << j for j in range(w))
        out[i] ^= word
    for i in range(rate_words, 24):
        out[i] ^= state[i]
    assert all(0 <= x <= mask for x in out)
    return out


def hash_bits(message: list[int], w: int, rounds: int) -> list[int]:
    b = 24 * w
    rate = 8 * w
    length = len(message)
    padded = pad_bits(message, rate)
    state = [0] * 24
    length &= (1 << 64) - 1
    if w == 32:
        state[-2] = length & ((1 << 32) - 1)
        state[-1] = length >> 32
    elif w == 64:
        state[-1] = length
    else:
        # Last 64 bits of the state occupy the high 64 bits of word 23.
        state[-1] = length << (w - 64)
    for pos in range(0, len(padded), rate):
        state = absorb_block(state, padded[pos:pos + rate], w, rounds)
    state = permutation(state, w, rounds)
    return [(state[i] >> j) & 1 for i in range(8) for j in range(w)]


def differential_profile(table: list[int], alphabet: int) -> tuple[int, list[tuple[int, int, list[int]]]]:
    maximum = 0
    rows = []
    for a in range(1, alphabet):
        counts = Counter(table[x] ^ table[x ^ a] for x in range(alphabet))
        high = max(counts.values())
        maximum = max(maximum, high)
        rows.append((a, high, sorted(b for b, n in counts.items() if n == high)))
    return maximum, rows


def walsh_profile(table: list[int], alphabet: int) -> tuple[int, list[tuple[int, int, int]]]:
    maximum = 0
    rows = []
    for a in range(alphabet):
        for b in range(1, alphabet):
            total = sum(
                -1 if ((a & x).bit_count() ^ (b & table[x]).bit_count()) & 1 else 1
                for x in range(alphabet)
            )
            maximum = max(maximum, abs(total))
            rows.append((a, b, total))
    return maximum, rows


def dependence_growth(w: int = 32, rounds: int = 4) -> list[list[int]]:
    """Conservative support of each round-output bit in the round's input bits."""
    # First derive the input support of every bit of S24.  Checking both zero and
    # one for each coordinate is exact for an influence test: if a coordinate
    # changes any output on those points, it is a true structural dependency.
    support24 = []
    for out_bit in range(24):
        support = 0
        for in_bit in range(24):
            unit = 1 << in_bit
            if ((s24(0) >> out_bit) & 1) != ((s24(unit) >> out_bit) & 1):
                support |= 1 << in_bit
        support24.append(support)

    # Conservative support propagation.  Every round output bit can depend on
    # every S24 input bit that influences some S24 output bit in its slice.
    deps = []
    for out_i in range(24):
        row = []
        for j in range(w):
            support = 0
            for in_i in range(24):
                if (support24[out_i] >> in_i) & 1:
                    support |= 1 << (in_i * w + j)
            row.append(support)
        deps.append(row)
    return deps


def main() -> None:
    print("S6", differential_profile([s6(x) for x in range(64)], 64)[0],
          walsh_profile([s6(x) for x in range(64)], 64)[0])
    for w in (32, 64, 96, 128):
        rng = random.Random(w)
        state = [rng.getrandbits(w) for _ in range(24)]
        rounds = {32: 16, 64: 24, 96: 32, 128: 40}[w]
        out = permutation(state, w, rounds)
        print("permutation", w, len(out), sum(x.bit_count() for x in out))


if __name__ == "__main__":
    main()
