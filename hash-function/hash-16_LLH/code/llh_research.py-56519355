#!/usr/bin/env python3
"""Literal research model for the LLH specification in hash-16-spec.pdf.

This is a working model, not a claimed reference implementation.  State rows are
integers whose bit j is the specification's column j.  The bit ordering follows
the document's little-endian discussion and its row-major S24 diagram.
"""

from __future__ import annotations

from collections import Counter
from dataclasses import dataclass
import random


