# DOVE layout: source trees DOVE_{classic|pkc_skc}_{ref|avx2}
# Benchmark targets: DOVE_{classic|pkc_skc}_{128|256|512} (one library per variant × level)

function(sig_discover_dove_implementations IMPL_ROOT IMPL_SUFFIX OUT_VARIANT_DIRS OUT_BENCH_FOLDERS)
    set(_variants "")
    set(_bench "")
    if(NOT IS_DIRECTORY "${IMPL_ROOT}")
        message(FATAL_ERROR "Implementation root not found: ${IMPL_ROOT}")
    endif()
    file(GLOB _children RELATIVE "${IMPL_ROOT}" "${IMPL_ROOT}/DOVE_*_${IMPL_SUFFIX}")
    list(SORT _children)
    foreach(_v ${_children})
        if(NOT IS_DIRECTORY "${IMPL_ROOT}/${_v}")
            continue()
        endif()
        string(REGEX MATCH "^DOVE_(classic|pkc_skc)_${IMPL_SUFFIX}$" _ok "${_v}")
        if(NOT _ok)
            continue()
        endif()
        string(REGEX REPLACE "_${IMPL_SUFFIX}$" "" _base "${_v}")
        foreach(_level 128 256 512)
            list(APPEND _bench "${_base}_${_level}")
        endforeach()
        list(APPEND _variants "${_v}")
    endforeach()
    if(NOT _variants)
        message(FATAL_ERROR
            "No DOVE variant folders found under ${IMPL_ROOT}. "
            "Expected DOVE_classic_${IMPL_SUFFIX} and/or DOVE_pkc_skc_${IMPL_SUFFIX}.")
    endif()
    list(SORT _bench)
    set(${OUT_VARIANT_DIRS} ${_variants} PARENT_SCOPE)
    set(${OUT_BENCH_FOLDERS} ${_bench} PARENT_SCOPE)
endfunction()

function(sig_parse_folder_name FOLDER OUT_FAMILY OUT_LEVEL)
    if(NOT FOLDER MATCHES "^(.+)_([0-9]+)$")
        message(FATAL_ERROR "Invalid algorithm folder name: ${FOLDER}")
    endif()
    set(${OUT_FAMILY} "${CMAKE_MATCH_1}" PARENT_SCOPE)
    set(${OUT_LEVEL} "${CMAKE_MATCH_2}" PARENT_SCOPE)
endfunction()

function(sig_dove_param_set LEVEL OUT_PARAM)
    if(LEVEL STREQUAL "128")
        set(${OUT_PARAM} "DOVE128" PARENT_SCOPE)
    elseif(LEVEL STREQUAL "256")
        set(${OUT_PARAM} "DOVE256" PARENT_SCOPE)
    elseif(LEVEL STREQUAL "512")
        set(${OUT_PARAM} "DOVE512" PARENT_SCOPE)
    else()
        message(FATAL_ERROR "Unsupported DOVE security level: ${LEVEL}")
    endif()
endfunction()

function(sig_dove_variant_dir FAMILY IMPL_SUFFIX OUT_DIR)
    set(${OUT_DIR} "${FAMILY}_${IMPL_SUFFIX}" PARENT_SCOPE)
endfunction()

function(sig_dove_filter_sources SRC_DIR OUT_SRCS)
    file(GLOB _root_srcs "${SRC_DIR}/*.c")
    file(GLOB _uov_srcs "${SRC_DIR}/uov/*.c")
    set(_srcs ${_root_srcs} ${_uov_srcs})
    list(FILTER _srcs EXCLUDE REGEX ".*/(KAT_SIG|KAT_KEM|KAT_KEX|bench_sign)\\.c$")
    set(${OUT_SRCS} ${_srcs} PARENT_SCOPE)
endfunction()
